    "lint:fix": "eslint js/ scripts/ --fix",
    "format": "prettier --write \"js/**/*.js\" \"scripts/**/*.js\" \"css/**/*.css\"",
    "format:check": "prettier --check \"js/**/*.js\" \"scripts/**/*.js\" \"css/**/*.css\"",
    "test": "node scripts/verify-syntax.js && node scripts/test-modules.js",
    "check": "node scripts/verify-syntax.js"
